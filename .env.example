# Database Configuration
DATABASE_URL=postgresql+asyncpg://sandbox:sandbox_password@localhost:5432/text2sql
DATABASE_URL_SYNC=postgresql://sandbox:sandbox_password@localhost:5432/text2sql

# Sandbox Configuration
SANDBOX_USER=sandbox
SANDBOX_PASSWORD=sandbox_password
SANDBOX_DB=text2sql

# Query Settings
QUERY_TIMEOUT_SECONDS=30
QUERY_ROW_LIMIT=10000

# Admin Database (for creating sandbox role)
ADMIN_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ============================================================================
# NL2SQL Agent Configuration
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# PostgreSQL Read-Only Connection (nl2sql_ro role)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=text2sql
PG_USER=nl2sql_ro
PG_PASSWORD=nl2sql_ro_password
PG_STATEMENT_TIMEOUT_MS=30000

# LangSmith Tracing (optional but recommended)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=olist-nl2sql
LANGSMITH_TRACING=true

# Dataset Reference Date (optional, auto-detected from data)
# NOW_OVERRIDE=2018-08-29
